  out = replaceOnce(out,
    "      await persist({ nextAction: state.status, auditRunId: null });",
    "      await persist({ nextAction: state.status, auditRunId: auditRun.id, auditRequestFingerprint: result.requestFingerprint });",
    'resume audit provenance persist');
  out = replaceOnce(out,
    "  pullRequest = await fetchPullRequest(targetRepository, resumePr, targetReadToken);\n  const payload = {",
