  let out = body;
  // The worker helper is already correlated; audit call was patched above. Ensure no ID-difference heuristic remains.
  if (out.includes('const before = new Set')) throw new Error('legacy unseen-run resolver still present in initial controller');
  if (out.includes('auditResultFromComment')) throw new Error('legacy PR-comment audit authority still present in initial controller');
  return out + '\n';
});
