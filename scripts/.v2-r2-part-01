{ inputs.prior_findings_json }}\n      AUDIT_RESULT_PATH:",
    'audit prior findings env'
  );
  await save(path, s);
}

// 3) Audit runner consumes the controller-provided prior finding lineage and fails closed on malformed input.
{
  const path = 'scripts/run-delivery-v2-github-audit.mjs';
  let s = await load(path);
  const helper = [
    '',
    'function priorFindingsFromEnv() {',
    "  const raw = String(process.env.PRIOR_FINDINGS_JSON ?? '[]').trim() || '[]';",
    '  const parsed = JSON.parse(raw);',
    "  if (!Array.isArray(parsed)) throw new Error('PRIOR_FINDINGS_JSON must be a JSON array');",
    '  return parsed.map((finding, index) => {',
    "    if (!finding || Array.isArray(finding) || typeof finding !== 'object') throw new Error(`PRIOR_FINDINGS_JSON[${index}] must be an object`);",
    "    const id = String(finding.id ?? '').trim();",
    "    const candidateSha = String(finding.candidateSha ?? '').trim().toLowerCase();",
    "    const status = String(finding.status ?? '').trim();",
    "    if (!id || !/^[0-9a-f]{40}$/.test(candidateSha) || !status) throw new Error(`PRIOR_FINDINGS_JSON[${index}] is incomplete`);",
    '    return Object.freeze({ id, candidateSha, status });',
    '  });',
    '}',
    ''
  ].join('\n');
  s = insertBeforeOnce(s, '\nasync function main() {', helper, 'prior findings parser');
  s = replaceOnce(
    s,
    "  const implementerRunId = positiveInteger('IMPLEMENTER_RUN_ID');\n  const token = requiredEnv('DELIVERY_GITHUB_READ_TOKEN');",
    "  const implementerRunId = positiveInteger('IMPLEMENTER_RUN_ID');\n  const priorFindings = priorFindingsFromEnv();\n  const token = requiredEnv('DELIVERY_GITHUB_READ_TOKEN');",
    'audit prior findings load'
  );
  s = replaceOnce(
    s,
    "    implementationAttempt: positiveInteger('IMPLEMENTATION_ATTEMPT', '1'),\n    implementer: { provider: implementerProvider, workerIdentity: implementerWorkerIdentity, runId: implementerRunId }\n  });",
    "    implementationAttempt: positiveInteger('IMPLEMENTATION_ATTEMPT', '1'),\n    implementer: { provider: implementerProvider, workerIdentity: implementerWorkerIdentity, runId: implementerRunId },\n    priorFindings\n  });",
    'audit request prior findings'
  );
  await save(path, s);
}

// 4) Reentry with a managed PR but no canonical state fails closed instead of resetting unknown budgets.
{
  const path = 'scripts/guard-delivery-v2-reentry.mjs';
  let s = await load(path);
  s = replaceOnce(
    s,
    "    if (!stateEnvelope) {\n      return Object.freeze({\n        runController: true,\n        resumePr: prNumber,\n        status: 'resume-existing-delivery',\n        pullRequestNumber: prNumber,\n        materialHeadSha: remoteHeadSha,\n        staleStateDetected: true,\n        nextAction: 'recover-pr-state'\n      });\n    }",
    "    if (!stateEnvelope) {\n      return Object.freeze({\n        runController: false,\n        resumePr: null,\n        status: 'escalated-missing-persistent-state',\n        pullRequestNumber: prNumber,\n        materialHeadSha: remoteHeadSha,\n        staleStateDetected: true,\n        nextAction: 'human-escalation',\n        attempts: null\n      });\n    }",
    'missing state fail closed'
  );
  await save(path, s);
}

