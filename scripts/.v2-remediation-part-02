    "  const readToken = requiredEnv('DELIVERY_GITHUB_READ_TOKEN');\n  const resultPath = String(process.env.CONTROLLER_RESULT_PATH ?? '').trim();",
    "  const readToken = requiredEnv('DELIVERY_GITHUB_READ_TOKEN');\n  const actionsToken = requiredEnv('GITHUB_TOKEN');\n  const orchestratorRepository = requiredEnv('GITHUB_REPOSITORY');\n  const orchestratorRef = requiredEnv('ORCHESTRATOR_WORKER_REF');\n  const resultPath = String(process.env.CONTROLLER_RESULT_PATH ?? '').trim();",
    'guard actions identity');
  out = replaceOnce(out,
    "  const decision = evaluateReentry({ pullRequest, stateEnvelope, bootstrapLease, targetRepository, issueNumber, baseBranch, provider });",
    "  const recoveredWorkerRun = bootstrapLease ? await recoverBootstrapWorkerRun(bootstrapLease, orchestratorRepository, orchestratorRef, actionsToken) : null;\n  const decision = evaluateReentry({ pullRequest, stateEnvelope, bootstrapLease, targetRepository, issueNumber, baseBranch, provider, recoveredWorkerRun });",
    'guard recovered run');
  return out;
});

// Reservation is idempotently upserted and increments the durable attempt budget only for authorized AI work.
await edit('scripts/reserve-delivery-v2-initial-attempt.mjs', (body) => {
  let out = replaceOnce(body,
    "import { createDispatchDecision } from '../src/v2/dispatch-policy.mjs';",
    "import { createDispatchDecision } from '../src/v2/dispatch-policy.mjs';\nimport { executionPolicyFor } from '../src/v2/execution-policy.mjs';\nimport { createDispatchNonce } from '../src/v2/controller-runtime.mjs';",
    'reserve imports');
  out = replaceOnce(out,
    "export function bootstrapLeaseForDecision({ decision, repository, issueNumber, baseBranch, provider, requestedRisk, runId } = {}) {\n  if (!decision?.dispatchAllowed) return null;\n  return Object.freeze({",
    "export function bootstrapLeaseForDecision({ decision, repository, issueNumber, baseBranch, provider, requestedRisk, runId, priorImplementationAttempts = 0, workerWorkflow, dispatchNonce = createDispatchNonce() } = {}) {\n  if (!decision?.dispatchAllowed) return null;\n  const policy = executionPolicyFor(decision.securityProfile);\n  const nextAttempt = Number(priorImplementationAttempts) + 1;\n  if (!Number.isInteger(nextAttempt) || nextAttempt < 1 || nextAttempt > policy.maxImplementationAttempts) throw new Error('initial implementation attempt budget exhausted');\n  return Object.freeze({",
    'reserve budget');
  out = replaceOnce(out,
    "    implementationAttempts: 1,\n    status: 'reserved-initial-attempt',\n    controllerRunId: Number(runId)",
    "    implementationAttempts: nextAttempt,\n    status: 'reserved-initial-attempt',\n    controllerRunId: Number(runId),\n    workerRunId: null,\n    workerWorkflow: String(workerWorkflow ?? ''),\n    dispatchNonce: String(dispatchNonce)",
    'reserve lease fields');
  out = replaceOnce(out,
    "  const runId = positiveInteger(requiredEnv('GITHUB_RUN_ID'), 'GITHUB_RUN_ID');",
    "  const runId = positiveInteger(requiredEnv('GITHUB_RUN_ID'), 'GITHUB_RUN_ID');\n  const priorImplementationAttempts = Number.parseInt(String(process.env.DELIVERY_V2_PRIOR_INITIAL_ATTEMPTS ?? '0'), 10);",
    'reserve prior attempts');
  out = replaceOnce(out,
    "  const lease = bootstrapLeaseForDecision({ decision, repository, issueNumber, baseBranch, provider, requestedRisk, runId });",
    "  const lease = bootstrapLeaseForDecision({ decision, repository, issueNumber, baseBranch, provider, requestedRisk, runId, priorImplementationAttempts, workerWorkflow: plan.implementation.workflow });",
    'reserve lease call');
  out = replaceOnce(out,
    "    await postJson(`https://api.github.com/repos/${repository}/issues/${issueNumber}/comments`, writeToken, { body });",
    "    const comments = await api(`https://api.github.com/repos/${repository}/issues/${issueNumber}/comments?per_page=100`, readToken);\n    const existing = comments.find((comment) => String(comment.body ?? '').startsWith(BOOTSTRAP_MARKER));\n    if (existing) await api(`https://api.github.com/repos/${repository}/issues/comments/${existing.id}`, writeToken, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ body }) });\n    else await postJson(`https://api.github.com/repos/${repository}/issues/${issueNumber}/comments`, writeToken, { body });",
    'reserve upsert');
  out = replaceOnce(out,
    "  if (outputPath) await appendFile(outputPath, `reserved=${lease ? 'true' : 'false'}\\n`, 'utf8');",
    "  if (outputPath) await appendFile(outputPath, `reserved=${lease ? 'true' : 'false'}\\nattempts=${lease?.implementationAttempts ?? priorImplementationAttempts}\\ndispatch_nonce=${lease?.dispatchNonce ?? ''}\\n`, 'utf8');",
    'reserve outputs');
  return out;
});

// Dispatch workflow: trusted default-branch control plane + one unified controller entrypoint.
await edit('.github/workflows/delivery-v2-dispatch.yml', (body) => {
  let out = replaceOnce(body,
    '      ORCHESTRATOR_WORKER_REF: ${{ github.ref_name }}',
    '      ORCHESTRATOR_WORKER_REF: ${{ github.event.repository.default_branch }}',
    'dispatch trusted worker ref');
  out = replaceOnce(out,
    "      - name: Checkout deterministic control plane\n        uses: actions/checkout@v4",
    "      - name: Checkout deterministic control plane\n        uses: actions/checkout@v4\n        with:\n          ref: ${{ github.event.repository.default_branch }}",
    'dispatch trusted checkout');
  out = replaceOnce(out,
    "      - name: Reserve initial implementation attempt\n        if: steps.reentry.outputs.run_controller == 'true' && steps.reentry.outputs.resume_pr == ''\n        run: node scripts/reserve-delivery-v2-initial-attempt.mjs",
    "      - name: Reserve initial implementation attempt\n        id: reserve\n        if: steps.reentry.outputs.run_controller == 'true' && steps.reentry.outputs.resume_pr == '' && steps.reentry.outputs.recover_worker_run_id == ''\n        env:\n          DELIVERY_V2_PRIOR_INITIAL_ATTEMPTS: ${{ steps.reentry.outputs.prior_initial_attempts }}\n        run: node scripts/reserve-delivery-v2-initial-attempt.mjs",
    'dispatch reserve step');
  out = replaceOnce(out,
    "      - name: Build initial deterministic plan\n        if: steps.reentry.outputs.run_controller == 'true' && steps.reentry.outputs.resume_pr == ''\n        run: node src/cli.mjs plan-v2 | tee \"${RUNNER_TEMP}/delivery-v2-initial-plan.json\"\n\n      - name: Run initial bounded Delivery V2 controller\n        if: steps.reentry.outputs.run_controller == 'true' && steps.reentry.outputs.resume_pr == ''\n        run: node scripts/run-delivery-v2-controller.mjs\n\n      - name: Resume existing Delivery V2 controller\n        if: steps.reentry.outputs.run_controller == 'true' && steps.reentry.outputs.resume_pr != ''\n        env:\n          DELIVERY_V2_RESUME_PR: ${{ steps.reentry.outputs.resume_pr }}\n        run: node scripts/resume-delivery-v2-controller.mjs",
    "      - name: Build initial deterministic plan\n        if: steps.reentry.outputs.run_controller == 'true' && steps.reentry.outputs.resume_pr == '' && steps.reentry.outputs.recover_worker_run_id == ''\n        run: node src/cli.mjs plan-v2 | tee \"${RUNNER_TEMP}/delivery-v2-initial-plan.json\"\n\n      - name: Run bounded Delivery V2 controller\n        if: steps.reentry.outputs.run_controller == 'true'\n        env:\n          DELIVERY_V2_RESUME_PR: ${{ steps.reentry.outputs.resume_pr }}\n          DELIVERY_V2_INITIAL_ATTEMPTS: ${{ steps.reserve.outputs.attempts || steps.reentry.outputs.prior_initial_attempts || '1' }}\n          DELIVERY_V2_INITIAL_DISPATCH_NONCE: ${{ steps.reserve.outputs.dispatch_nonce || steps.reentry.outputs.dispatch_nonce }}\n          DELIVERY_V2_RECOVER_WORKER_RUN_ID: ${{ steps.reentry.outputs.recover_worker_run_id }}\n        run: node scripts/run-delivery-v2-controller.mjs",
    'dispatch unified controller');
  return out;
});

// Shared controller patches.
for (const path of ['scripts/run-delivery-v2-controller.mjs', 'scripts/resume-delivery-v2-controller.mjs']) {
  await edit(path, (body) => {
    let out = body;
    const importAnchor = path.includes('resume-')
      ? "import { reconcilePersistentState } from '../src/v2/persistent-state.mjs';"
      : "import { mergeGhAwUsage, normalizeGhAwUsage, parseGhAwUsageJsonl } from '../src/v2/usage-telemetry.mjs';";
    const importText = `${importAnchor}\nimport { ciFailureClassForConclusion, createDispatchNonce, loadAuthoritativeAuditResult, publishReleaseStatus, selectCorrelatedWorkflowRun } from '../src/v2/controller-runtime.mjs';`;
    out = replaceOnce(out, importAnchor, importText, `${path}: runtime import`);
    out = out.replace(/const orchestratorRef = process\.env\.ORCHESTRATOR_WORKER_REF \|\| process\.env\.GITHUB_REF_NAME \|\| 'main';/, "const orchestratorRef = requiredEnv('ORCHESTRATOR_WORKER_REF');");
