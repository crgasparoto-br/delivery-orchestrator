{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trusted-auditors.schema.json",
  "type": "object",
  "required": ["schema_version", "auditors"],
  "properties": {
    "schema_version": {"const": 1},
    "auditors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key_id", "name", "enabled", "repositories", "public_key_pem", "public_key_sha256"],
        "properties": {
          "key_id": {"type": "string", "minLength": 4},
          "name": {"type": "string", "minLength": 3},
          "enabled": {"const": true},
          "repositories": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "public_key_pem": {"type": "string", "minLength": 80},
          "public_key_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
