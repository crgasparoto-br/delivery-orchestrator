{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestration-state.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "repository_path",
    "issue",
    "base_ref",
    "branch",
    "state",
    "cycle",
    "head_sha",
    "base_sha",
    "merge_preview_sha",
    "implementation_context_id",
    "current_artifacts",
    "invalidated_artifacts",
    "findings",
    "external_audit",
    "audit_history",
    "invalidated_audits",
    "transitions"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "repository": {
      "type": "string",
      "minLength": 3
    },
    "repository_path": {
      "type": "string",
      "minLength": 1
    },
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "base_ref": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "pendente",
        "em-correcao",
        "verificado",
        "pronto-para-auditoria-independente",
        "bloqueado",
        "aprovado"
      ]
    },
    "cycle": {
      "type": "integer",
      "minimum": 1
    },
    "head_sha": {
      "type": "string",
      "minLength": 7
    },
    "base_sha": {
      "type": "string",
      "minLength": 7
    },
    "merge_preview_sha": {
      "type": "string"
    },
    "implementation_context_id": {
      "type": "string",
      "minLength": 8
    },
    "current_artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "head_sha",
          "base_sha",
          "merge_preview_sha",
          "cycle",
          "registered_at"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "head_sha": {
            "type": "string",
            "minLength": 7
          },
          "base_sha": {
            "type": "string",
            "minLength": 7
          },
          "merge_preview_sha": {
            "type": "string",
            "minLength": 7
          },
          "cycle": {
            "type": "integer",
            "minimum": 1
          },
          "registered_at": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": true
      }
    },
    "invalidated_artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "external_audit": {
      "type": [
        "object",
        "null"
      ]
    },
    "audit_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "invalidated_audits": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "contract_version": {
      "const": "2026-08-06.2"
    },
    "controller_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "delivery-single-invocation",
        "issue-loop-single-invocation"
      ]
    },
    "controller_context_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "controller_state_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "controller_cycle": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "cycle_authority": {
      "enum": [
        "entregar-issue",
        "issue-loop-engineer",
        "orquestrador"
      ]
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "aprovado"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "external_audit": {
            "type": "object",
            "required": [
              "report_id",
              "result",
              "report_path",
              "report_sha256",
              "trusted_auditors_path",
              "trusted_auditors_sha256",
              "signature",
              "trusted_auditor",
              "head_sha",
              "base_sha",
              "merge_preview_sha",
              "orchestration_cycle",
              "independent",
              "same_conversation"
            ],
            "properties": {
              "result": {
                "const": "approved"
              },
              "independent": {
                "const": true
              },
              "same_conversation": {
                "const": false
              },
              "report_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "trusted_auditors_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "signature": {
                "type": "object"
              },
              "trusted_auditor": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "controller_mode": {
            "enum": [
              "delivery-single-invocation",
              "issue-loop-single-invocation"
            ]
          }
        },
        "required": [
          "controller_mode"
        ]
      },
      "then": {
        "required": [
          "contract_version",
          "controller_context_id",
          "controller_state_revision",
          "controller_cycle",
          "cycle_authority"
        ],
        "properties": {
          "cycle_authority": {
            "enum": [
              "entregar-issue",
              "issue-loop-engineer"
            ]
          },
          "contract_version": {
            "const": "2026-08-06.2"
          }
        }
      }
    }
  ]
}
