{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solverit.invalid/issue-engineering/controller-context-v2.schema.json",
  "title": "Issue engineering controller context v2",
  "type": "object",
  "required": [
    "schema_version",
    "contract_version",
    "controller_context_id",
    "controller_revision",
    "controller_cycle",
    "controller_cycle_limit",
    "repository",
    "repository_path",
    "issue",
    "base_ref",
    "branch",
    "pull_request",
    "identity",
    "permissions",
    "workflow_policy",
    "workflow_inventory",
    "baseline",
    "source_manifest",
    "metrics",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "2026-08-06.2"
    },
    "controller_context_id": {
      "type": "string",
      "minLength": 8
    },
    "controller_revision": {
      "type": "integer",
      "minimum": 1
    },
    "controller_cycle": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "controller_cycle_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "repository": {
      "type": "string",
      "minLength": 3
    },
    "repository_path": {
      "type": "string",
      "minLength": 1
    },
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "base_ref": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "pull_request": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "identity": {
      "type": "object",
      "required": [
        "head_sha",
        "base_sha",
        "merge_preview_sha",
        "captured_at",
        "observed_at"
      ],
      "properties": {
        "head_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "merge_preview_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "permissions": {
      "type": "object",
      "required": [
        "may_write_code",
        "may_update_issue",
        "may_merge",
        "may_execute_destructive_actions"
      ],
      "properties": {
        "may_write_code": {
          "type": "boolean"
        },
        "may_update_issue": {
          "type": "boolean"
        },
        "may_merge": {
          "const": false
        },
        "may_execute_destructive_actions": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "workflow_policy": {
      "type": "object",
      "required": [
        "workflow_change_authorized",
        "manual_approval_workflow_authorized",
        "remote_action_mode",
        "publish_policy"
      ],
      "properties": {
        "workflow_change_authorized": {
          "type": "boolean"
        },
        "manual_approval_workflow_authorized": {
          "const": false
        },
        "remote_action_mode": {
          "const": "observe-only"
        },
        "publish_policy": {
          "const": "single-final-candidate"
        }
      },
      "additionalProperties": false
    },
    "workflow_inventory": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "baseline": {
      "type": "object"
    },
    "source_manifest": {
      "type": "object"
    },
    "metrics": {
      "type": "object",
      "required": [
        "issue_full_reads",
        "documentation_full_scans",
        "subskill_calls",
        "full_suites",
        "freezes",
        "remote_collections",
        "reused_stages",
        "avoidable_invalidations"
      ],
      "properties": {
        "issue_full_reads": {
          "type": "integer",
          "minimum": 0
        },
        "documentation_full_scans": {
          "type": "integer",
          "minimum": 0
        },
        "subskill_calls": {
          "type": "integer",
          "minimum": 0
        },
        "full_suites": {
          "type": "integer",
          "minimum": 0
        },
        "freezes": {
          "type": "integer",
          "minimum": 0
        },
        "remote_collections": {
          "type": "integer",
          "minimum": 0
        },
        "reused_stages": {
          "type": "integer",
          "minimum": 0
        },
        "avoidable_invalidations": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
