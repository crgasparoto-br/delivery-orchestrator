{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-metrics.schema.json",
  "type": "object",
  "required": ["schema_version", "head_sha", "routes"],
  "properties": {
    "schema_version": {"const": 2},
    "head_sha": {"type": "string", "minLength": 7},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["route", "viewports", "long_content_or_zoom", "keyboard_only", "accessibility_tree"],
        "properties": {
          "route": {"type": "string", "minLength": 1},
          "viewports": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
          "long_content_or_zoom": {"const": true},
          "keyboard_only": {"const": true},
          "accessibility_tree": {"type": "object"}
        }
      }
    }
  },
  "additionalProperties": true
}
