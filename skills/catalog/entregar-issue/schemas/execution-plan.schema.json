{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solverit.invalid/issue-engineering/execution-plan-v2.schema.json",
  "title": "Deterministic issue execution plan v2",
  "type": "object",
  "required": [
    "schema_version",
    "contract_version",
    "controller_context_id",
    "controller_revision",
    "controller_cycle",
    "profile",
    "risk_signals",
    "applicable_skills",
    "required_gates",
    "domain_requests",
    "execution_order",
    "stages",
    "reusable_stages",
    "invalidated_stages",
    "context_fingerprints",
    "change_classification",
    "work_items",
    "work_item_fingerprint",
    "internal_plan",
    "skill_plan",
    "publication",
    "plan_fingerprint",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "contract_version": {
      "const": "2026-08-06.2"
    },
    "controller_context_id": {
      "type": "string",
      "minLength": 8
    },
    "controller_revision": {
      "type": "integer",
      "minimum": 1
    },
    "controller_cycle": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "profile": {
      "enum": [
        "light",
        "standard",
        "critical"
      ]
    },
    "risk_signals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "applicable_skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "required_gates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "domain_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill",
          "requirements",
          "paths",
          "reason",
          "input_fingerprint"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "input_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "execution_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "fingerprint",
          "input_fingerprint",
          "depends_on",
          "dependency_fingerprints",
          "reused",
          "invalidated_by"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "input_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "dependency_fingerprints": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "reused": {
            "type": "boolean"
          },
          "invalidated_by": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "reusable_stages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "invalidated_stages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "publication": {
      "type": "object",
      "required": [
        "allowed",
        "reason"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "plan_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "context_fingerprints": {
      "type": "object",
      "required": [
        "identity",
        "sources",
        "baseline",
        "workflows",
        "policy",
        "permissions"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sources": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "baseline": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "workflows": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "permissions": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "change_classification": {
      "type": "object",
      "required": [
        "docs_only",
        "assets_only",
        "generated_only",
        "test_only",
        "code_touched",
        "runtime_config_touched",
        "behavioral_change",
        "hygiene_applicable"
      ],
      "properties": {
        "docs_only": {
          "type": "boolean"
        },
        "assets_only": {
          "type": "boolean"
        },
        "generated_only": {
          "type": "boolean"
        },
        "test_only": {
          "type": "boolean"
        },
        "code_touched": {
          "type": "boolean"
        },
        "runtime_config_touched": {
          "type": "boolean"
        },
        "behavioral_change": {
          "type": "boolean"
        },
        "hygiene_applicable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "work_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "work_item_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "skill_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill",
          "action",
          "reason",
          "input_fingerprint",
          "requirements",
          "paths"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "run",
              "reuse-candidate",
              "not-applicable",
              "conditional"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "input_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "internal_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "action",
          "reason",
          "input_fingerprint",
          "requirements",
          "paths",
          "write_owner"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "run",
              "reuse-candidate",
              "not-applicable",
              "conditional"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "input_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "write_owner": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
