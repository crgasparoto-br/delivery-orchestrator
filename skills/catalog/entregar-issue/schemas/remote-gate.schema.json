{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remote-gate.schema.json",
  "type": "object",
  "required": [
    "schema_version", "provider", "repository", "pull_request", "base_ref",
    "head_sha", "head_sha_after", "base_sha", "base_sha_after",
    "merge_preview_sha", "merge_preview_sha_after", "observed_at", "source",
    "provenance", "pr", "changed_files", "workflows", "selected_runs_after",
    "no_applicable_pr_workflows", "artifact_runs", "artifacts", "issue_handoff"
  ],
  "properties": {
    "schema_version": {"const": 4},
    "provider": {"const": "github"},
    "repository": {"type": "string", "minLength": 3},
    "pull_request": {"type": "integer", "minimum": 1},
    "base_ref": {"type": "string", "minLength": 1},
    "head_sha": {"type": "string", "minLength": 7},
    "head_sha_after": {"type": "string", "minLength": 7},
    "base_sha": {"type": "string", "minLength": 7},
    "base_sha_after": {"type": "string", "minLength": 7},
    "merge_preview_sha": {"type": "string", "minLength": 7},
    "merge_preview_sha_after": {"type": "string", "minLength": 7},
    "observed_at": {"type": "string", "minLength": 20},
    "source": {"enum": ["gh-api", "github-rest-api", "fixture"]},
    "provenance": {
      "type": "object",
      "required": ["collector", "collector_version", "collector_sha256", "raw_payloads"],
      "properties": {
        "collector": {"const": "collect_remote_gate.py"},
        "collector_version": {"const": 4},
        "collector_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "raw_payloads": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["label", "path", "sha256", "endpoint", "retrieved_at"],
            "properties": {
              "label": {"type": "string", "minLength": 3},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "endpoint": {"type": "string", "minLength": 5},
              "retrieved_at": {"type": "string", "minLength": 10}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "pr": {
      "type": "object",
      "required": ["before", "after"],
      "properties": {"before": {"type": "object"}, "after": {"type": "object"}}
    },
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "workflows": {"type": "array", "items": {"type": "object"}},
    "selected_runs_after": {"type": "object"},
    "no_applicable_pr_workflows": {"type": "boolean"},
    "artifact_runs": {"type": "array", "items": {"type": "object"}},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "name", "kind", "kind_verified", "attestation", "run_id",
          "head_sha", "digest", "expired", "output_path", "payload_sha256",
          "archive_path", "archive_sha256"
        ],
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "name": {"type": "string"},
          "kind": {"type": "string"},
          "kind_verified": {"type": "boolean"},
          "run_id": {"type": "integer", "minimum": 1},
          "head_sha": {"type": "string", "minLength": 7},
          "digest": {"type": "string", "pattern": "^sha256:"},
          "expired": {"type": ["boolean", "null"]},
          "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "archive_sha256": {"type": "string"},
          "attestation": {"type": "object"}
        }
      }
    },
    "issue_handoff": {
      "type": "object",
      "required": ["issue", "head_sha", "location", "url"]
    }
  },
  "additionalProperties": true
}
