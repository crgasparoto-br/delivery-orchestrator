{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solverit.invalid/issue-engineering/subskill-result-v3.schema.json",
  "title": "Issue engineering orchestrated subskill result v3",
  "type": "object",
  "required": [
    "schema_version",
    "contract_version",
    "skill",
    "mode",
    "status",
    "findings",
    "validations",
    "artifacts",
    "changed_files",
    "limitations",
    "requires_refreeze",
    "input_fingerprint",
    "reused"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "2026-08-06.2"
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "passed",
        "passed-with-limitations",
        "findings",
        "specification-gap",
        "blocked",
        "not-applicable",
        "no-change",
        "contract-mismatch"
      ]
    },
    "summary": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "documentation_impacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_refreeze": {
      "type": "boolean"
    },
    "data": {
      "type": "object"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reused": {
      "type": "boolean"
    },
    "reuse_source": {
      "type": "object",
      "required": [
        "result_path",
        "sha256",
        "input_fingerprint"
      ],
      "properties": {
        "result_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "skip_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "skill": {
            "const": "auditar-issue"
          },
          "mode": {
            "const": "controller-adversarial"
          }
        },
        "required": [
          "skill",
          "mode"
        ]
      },
      "then": {
        "required": [
          "requirements",
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "controller_disposition",
              "assurance_level",
              "release_gate_satisfied",
              "approval_scope",
              "verdict",
              "requirements",
              "blocking_findings",
              "recommendations",
              "gates",
              "limitations",
              "identity",
              "modifications_detected",
              "evidence_artifacts"
            ],
            "properties": {
              "controller_disposition": {
                "enum": [
                  "internally-approved",
                  "remediation-required"
                ]
              },
              "assurance_level": {
                "const": "controller-adversarial"
              },
              "verdict": {
                "enum": [
                  "Aprovado",
                  "Aprovado com ressalvas",
                  "Reprovado"
                ]
              },
              "requirements": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object"
                }
              },
              "blocking_findings": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "recommendations": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "gates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object"
                }
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "identity": {
                "type": "object"
              },
              "modifications_detected": {
                "const": false
              },
              "evidence_artifacts": {
                "type": "object",
                "required": [
                  "source_manifest",
                  "requirements_rederivation",
                  "coverage_matrix",
                  "controller_audit_report"
                ],
                "properties": {
                  "source_manifest": {
                    "type": "object",
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "additionalProperties": false
                  },
                  "requirements_rederivation": {
                    "type": "object",
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "additionalProperties": false
                  },
                  "coverage_matrix": {
                    "type": "object",
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "additionalProperties": false
                  },
                  "controller_audit_report": {
                    "type": "object",
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "approval_scope": {
                "const": "internal-only"
              },
              "release_gate_satisfied": {
                "const": false
              }
            },
            "additionalProperties": true
          },
          "requires_refreeze": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reused": {
            "const": true
          }
        },
        "required": [
          "reused"
        ]
      },
      "then": {
        "required": [
          "input_fingerprint",
          "reuse_source"
        ],
        "properties": {
          "changed_files": {
            "maxItems": 0
          },
          "requires_refreeze": {
            "const": false
          },
          "reuse_source": {
            "properties": {
              "input_fingerprint": {
                "$ref": "#/properties/input_fingerprint"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "not-applicable",
              "no-change",
              "contract-mismatch"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "skip_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "reused": {
            "const": false
          }
        },
        "required": [
          "reused"
        ]
      },
      "then": {
        "not": {
          "required": [
            "reuse_source"
          ]
        }
      }
    }
  ]
}
