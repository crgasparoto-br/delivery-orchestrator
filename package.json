{
  "name": "delivery-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub-native delivery control plane with risk-adaptive CI and pluggable AI execution, retaining the independent V1 loop during migration.",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.144.6"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "validate": "node src/cli.mjs validate",
    "plan:v2": "node src/cli.mjs plan-v2",
    "export:v2:classifier": "node scripts/export-delivery-v2-classifier.mjs",
    "verify:v2": "node scripts/verify-delivery-v2-completeness.mjs && node scripts/verify-delivery-v2-targets.mjs",
    "verify:v2:complete": "node scripts/verify-delivery-v2-completeness.mjs --require-complete && node scripts/verify-delivery-v2-targets.mjs",
    "run": "node src/cli.mjs run"
  }
}
