# Functional scope. Required; leave empty until explicitly configured.
ORCHESTRATOR_REPOSITORIES=
# Fine-grained PAT used only for authentication/authorization.
GITHUB_TOKEN=
ORCHESTRATOR_HYGIENE_LOG_DIR=/var/log/delivery-orchestrator/branch-hygiene

# Versioned runtime promotion on the VPS.
ORCHESTRATOR_SOURCE_REPO=/opt/delivery-orchestrator
ORCHESTRATOR_RELEASES_DIR=/opt/delivery-orchestrator-runtime/releases
ORCHESTRATOR_CURRENT_LINK=/opt/delivery-orchestrator-runtime/current
ORCHESTRATOR_RELEASE_LOG_DIR=/var/log/delivery-orchestrator/release-update
ORCHESTRATOR_RELEASE_VALIDATION_DIR=/var/lib/delivery-orchestrator/release-validation
ORCHESTRATOR_RELEASE_LOCK_FILE=/run/lock/delivery-orchestrator-release-hygiene-process.lock
ORCHESTRATOR_RELEASE_RETENTION=3
