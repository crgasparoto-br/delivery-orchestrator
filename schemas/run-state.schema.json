{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Orchestrator Run State",
  "type": "object",
  "required": ["run_id", "repository", "issue_number", "status", "cycle", "max_cycles", "history"],
  "properties": {
    "run_id": {"type": "string"},
    "repository": {"type": "string"},
    "issue_number": {"type": "integer", "minimum": 1},
    "status": {"type": "string"},
    "cycle": {"type": "integer", "minimum": 0},
    "max_cycles": {"type": "integer", "minimum": 1},
    "material_head_sha": {"type": ["string", "null"]},
    "handoff_head_sha": {"type": ["string", "null"]},
    "history": {"type": "array"}
  }
}
