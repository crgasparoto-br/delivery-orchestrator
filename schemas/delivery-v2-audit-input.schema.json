{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solverit.local/schemas/delivery-v2-audit-input.schema.json",
  "title": "Delivery V2 GitHub-native audit input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "issueNumber", "pullRequestNumber", "baseRef", "baseSha", "headRef", "materialHeadSha", "risk", "classifier", "checks", "changedPaths", "implementationAttempt", "implementer"],
  "properties": {
    "schemaVersion": {"const": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "issueNumber": {"type": "integer", "minimum": 1},
    "pullRequestNumber": {"type": "integer", "minimum": 1},
    "baseRef": {"type": "string", "minLength": 1},
    "baseSha": {"$ref": "#/$defs/sha"},
    "headRef": {"type": "string", "minLength": 1},
    "materialHeadSha": {"$ref": "#/$defs/sha"},
    "mergePreviewSha": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
    "risk": {"type": "object", "additionalProperties": false, "required": ["profile", "reasons"], "properties": {"profile": {"enum": ["fast", "standard", "critical"]}, "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "classifier": {"type": "object", "additionalProperties": false, "required": ["version", "fingerprint"], "properties": {"version": {"type": "string", "minLength": 1}, "fingerprint": {"type": "string", "minLength": 1}}},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "changedPaths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "implementationAttempt": {"type": "integer", "minimum": 1},
    "implementer": {"type": "object", "additionalProperties": false, "required": ["provider", "workerIdentity", "runId"], "properties": {"provider": {"type": "string", "minLength": 1}, "workerIdentity": {"type": "string", "minLength": 1}, "runId": {"type": "integer", "minimum": 1}}},
    "priorFindings": {"type": "array", "items": {"type": "object", "required": ["id", "candidateSha", "status"], "properties": {"id": {"type": "string", "minLength": 1}, "candidateSha": {"$ref": "#/$defs/sha"}, "status": {"type": "string", "minLength": 1}}}},
    "legacyV1Handoff": {}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "workflowEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowId", "path", "state", "trustedBaseSha", "blobSha", "fingerprint"],
      "properties": {
        "workflowId": {"type": "integer", "minimum": 1},
        "path": {"type": "string", "minLength": 1},
        "state": {"const": "active"},
        "trustedBaseSha": {"$ref": "#/$defs/sha"},
        "blobSha": {"$ref": "#/$defs/sha"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "scope", "subjectSha", "status", "workflowRunId", "workflowEvidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "scope": {"enum": ["material-head", "merge-preview"]},
        "subjectSha": {"$ref": "#/$defs/sha"},
        "status": {"type": "string", "minLength": 1},
        "conclusion": {"type": ["string", "null"]},
        "workflowRunId": {"type": "integer", "minimum": 1},
        "workflowEvidence": {"$ref": "#/$defs/workflowEvidence"}
      }
    }
  }
}
