{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solverit.local/schemas/delivery-v2-audit-result.schema.json",
  "title": "Delivery V2 independent audit result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateSha", "decision", "requestFingerprint", "reviewer", "findings"],
  "properties": {
    "schemaVersion": {"const": 1},
    "candidateSha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "decision": {"enum": ["approved", "rejected", "not-required"]},
    "requestFingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "allowOptionalAudit": {"type": "boolean"},
    "reviewer": {"type": "object", "additionalProperties": false, "required": ["provider", "workerIdentity", "runId", "contextIsolation"], "properties": {"provider": {"type": "string", "minLength": 1}, "workerIdentity": {"type": "string", "minLength": 1}, "runId": {"type": "integer", "minimum": 1}, "contextIsolation": {"const": "candidate-contract-evidence-only"}}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "severity", "candidateSha", "violatedContract", "surface", "failureMode", "evidence", "remediationMode", "blocksRelease"], "properties": {"id": {"type": "string", "pattern": "^DV2-[A-Z0-9][A-Z0-9._-]*$"}, "severity": {"enum": ["info", "low", "medium", "high", "critical"]}, "candidateSha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}, "violatedContract": {"type": "string", "minLength": 1}, "surface": {"type": "string", "minLength": 1}, "failureMode": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}, "remediationMode": {"enum": ["targeted", "systemic"]}, "blocksRelease": {"type": "boolean"}}}}
  }
}
